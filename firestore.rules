rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔑 دالة مساعدة للتحقق من صلاحيات المدير (Admin)
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // 📦 مجموعة المنتجات (Products) - البحث يتم بالـ Slug
    match /products/{slug} {
      // السماح للجميع بقراءة وتصفح المنتجات
      allow read, get, list: if true;
      // منع الكتابة أو التعديل أو الحذف إلا للمدير فقط
      allow write: if isAdmin();
    }

    // 📝 مجموعة المقالات (Posts) - البحث يتم بالـ Slug
    match /posts/{slug} {
      // السماح للجميع بقراءة وتصفح المقالات والمدونة
      allow read, get, list: if true;
      // منع الكتابة أو التعديل أو الحذف إلا للمدير فقط
      allow write: if isAdmin();
    }

    // 🏷️ مجموعة الفئات والتصنيفات (Categories)
    match /categories/{categoryId} {
      // السماح للجميع بقراءة التصنيفات لتظهر في القوائم
      allow read, get, list: if true;
      // منع تعديلها أو إضافتها إلا للمدير فقط
      allow write: if isAdmin();
    }

    // 🛒 مجموعة طلبات الشراء (Orders)
    match /orders/{orderId} {
      // مسموح لأي زائر أو زبون بإنشاء وإرسال طلب شراء جديد
      allow create: if true;
      // قراءة الطلبات أو تعديل حالتها أو حذفها محصور فقط بالمدير لحماية خصوصية المشترين
      allow read, get, list, update, delete: if isAdmin();
    }

    // 🏫 مجموعة قوائم المدارس (School-lists)
    match /school-lists/{listId} {
      // مسموح لأي مستخدم (الجمهور) برفع قائمة مدرسته (الاسم، الهاتف، الصورة)
      allow create: if true;
      // تصفح القوائم المرفوعة أو تحميلها أو إدارتها محصور فقط بالمدير
      allow read, get, list, update, delete: if isAdmin();
    }

    // 🔒 حظر شامل لأي مجلدات أو مستندات أخرى غير مذكورة أعلاه
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
