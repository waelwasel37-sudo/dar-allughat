/* OrdersPage.module.css */

.ordersContainer {
    padding: 2rem;
    background-color: #f9fafb;
}

.headerContainer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
}

.title {
    font-size: 1.875rem;
    font-weight: 700;
    color: #111827;
}

.exportButton {
    background-color: #10b981;
    color: white;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
}

.exportButton:hover {
    background-color: #059669;
}

.exportButton:disabled {
    background-color: #d1d5db;
    cursor: not-allowed;
}

.loading, .error, .noOrders {
    text-align: center;
    font-size: 1.125rem;
    color: #4b5563;
    padding: 4rem 0;
}

.ordersList {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
}

.orderCard {
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transition: box-shadow 0.3s;
}

.orderCard:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

.cardHeader {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    background-color: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
}

.date {
    font-size: 0.75rem;
    color: #6b7280;
}

.sourceBadge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 9999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.sourcePOS {
    background-color: #e0f2fe;
    color: #0284c7;
}
.sourceWeb {
    background-color: #e0e7ff;
    color: #4338ca;
}

.statusBadge {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
}

.statusNew { background-color: #dbeafe; color: #2563eb; }
.statusProcessing { background-color: #fef3c7; color: #d97706; }
.statusDelivered { background-color: #d1fae5; color: #065f46; }
.statusCancelled { background-color: #fee2e2; color: #dc2626; }

.cardBody {
    padding: 1rem 1.25rem;
    font-size: 0.875rem;
    color: #374151;
}

.itemsTitle {
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    color: #111827;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.itemsList {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 150px;
    overflow-y: auto;
    padding-right: 8px;
}

.item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid #f3f4f6;
}

.item:last-child {
    border-bottom: none;
}

.itemImage {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 0.375rem;
}

.itemDetails {
    flex-grow: 1;
}

.cardActions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    background-color: #f9fafb;
    border-top: 1px solid #e5e7eb;
}

.statusSelect, .whatsappButton, .printButton, .deleteButton {
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    border: 1px solid #d1d5db;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.statusSelect { background-color: white; flex-grow: 1; }
.whatsappButton { background-color: #25d366; color: white; border-color: #25d366; }
.whatsappButton:hover { background-color: #128c7e; }

/* ========================================================================= */
/* 🖨️ أنماط البوليصة القابلة للطباعة                                       */
/* ========================================================================= */

.noPrint {
    /* يُستخدم في @media print */
}

.printOnly {
    display: none;
    font-family: 'Cairo', sans-serif;
    color: #000;
    background-color: #fff;
    padding: 10px;
}

.printHeader {
    text-align: center;
    border-bottom: 2px solid #000;
    padding-bottom: 10px;
    margin-bottom: 15px;
}

.printHeader h2 {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0;
}

.printHeader p {
    font-size: 0.8rem;
    margin: 2px 0;
}

.printDate, .printId {
    font-size: 0.75rem;
    font-family: monospace;
}

.printSection {
    margin-bottom: 15px;
    border-bottom: 1px dashed #888;
    padding-bottom: 10px;
}

.printSection:last-of-type {
    border-bottom: none;
}

.printSection h4 {
    font-weight: bold;
    font-size: 1rem;
    margin-bottom: 8px;
}

.printSection p {
    font-size: 0.8rem;
    margin: 4px 0;
}

.printItemsList {
    list-style: none;
    padding: 0;
    margin: 5px 0 0 0;
    font-size: 0.75rem;
}

.printItemsList li {
    padding: 2px 0;
}

.printTotalRow {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    font-size: 1.1rem;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 2px solid #000;
}

.printBarcodeSection {
    text-align: center;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px dashed #888;
}

.printBarcode {
    font-family: 'Libre Barcode 39', monospace;
    font-size: 2.5rem;
    line-height: 1;
}

.printFooterText {
    font-size: 0.7rem;
    color: #555;
    margin-top: 5px;
}

/* ========================================================================= */
/* 🖨️ الطباعة - إخفاء كل حاجة إلا البوليصة                                */
/* ========================================================================= */

/* ========================================================================= */
/* 🖨️ الطباعة - إخفاء كل حاجة إلا البوليصة (display مش visibility)       */
/* ========================================================================= */
@media print {
    /* ✅ 1. اخفي كل حاجة بـ display */
    body > * {
        display: none !important;
    }

    /* ✅ 2. اظهر البوليصة بس */
    .printOnly {
        display: block !important;
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 80mm !important;
        margin: 0 !important;
        padding: 2mm !important;
        background: #fff !important;
        color: #000 !important;
    }

    /* ✅ 3. اظهر العناصر جوه البوليصة */
    .printOnly * {
        visibility: visible !important;
    }

    /* ✅ 4. منع تقسيم العناصر */
    .printItemsList,
    .printBarcodeSection,
    .printTotalRow {
        page-break-inside: avoid;
        break-inside: avoid;
    }

    /* ✅ 5. الطابعة الحرارية 80mm */
    @page {
        size: 80mm auto;
        margin: 2mm !important;
    }
}
