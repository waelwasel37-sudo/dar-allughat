/* ✅ زر ارفع قائمة مدرستك - أزرق داكن */
.btn-school-list {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background-color: var(--color-primary);
  color: var(--color-white);
  padding: 0.85rem 1.25rem;
  border-radius: var(--border-radius-md);
  font-weight: bold;
  font-size: 0.9rem;
  border: none;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

.btn-school-list::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.35),
    transparent
  );
  transition: left 0.6s ease;
  pointer-events: none;
}

/* ✅ زر توريدات مصانع ومؤسسات - أخضر زمردي */
.btn-factory-supplies {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: linear-gradient(135deg, #047857 0%, #065f46 100%);
  color: var(--color-white);
  padding: 0.85rem 1.25rem;
  border-radius: var(--border-radius-md);
  font-weight: bold;
  font-size: 0.9rem;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  -webkit-tap-highlight-color: transparent;
}

.btn-factory-supplies::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.35),
    transparent
  );
  transition: left 0.6s ease;
  pointer-events: none;
}




/* ========================================================================= */
/* 🎬 مؤثرات الحركة - موبايل (Touch)                                        */
/* ========================================================================= */
@media (hover: none) {
  .btn-school-list:active {
    transform: scale(0.96);
    background-color: var(--color-primary-dark);
    box-shadow: 0 2px 8px rgba(10, 46, 84, 0.2);
    transition: all 0.1s ease;
  }

  .btn-factory-supplies:active {
    transform: scale(0.96);
    background: linear-gradient(135deg, #065f46 0%, #064e3b 100%);
    box-shadow: 0 2px 8px rgba(5, 150, 105, 0.2);
    transition: all 0.1s ease;
  }

  .search-submit-btn:active {
    transform: scale(0.92);
    background-color: var(--color-secondary);
    color: var(--color-primary);
    transition: all 0.1s ease;
  }
}

