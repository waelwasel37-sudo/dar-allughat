rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔑 الأدمن (المالك)
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'waelwasel37@gmail.com';
    }

    // 🎯 Editor (موظف)
    function isEditor() {
      return request.auth != null && 
             request.auth.token.email in [
               'waelwasel37@gmail.com',
               'dallughat@gmail.com',
               'bondka111@gmail.com'
             ];
    }

    // 📦 المنتجات
    match /products/{slug} {
      allow read, get, list: if true;
      allow write: if isEditor();
    }

    // 📝 المقالات
    match /posts/{slug} {
      allow read, get, list: if true;
      allow write: if isEditor();
    }

    // 🏷️ الفئات
    match /categories/{categoryId} {
      allow read, get, list: if true;
      allow write: if isEditor();
    }

    // 🛒 الطلبات
    match /orders/{orderId} {
      allow create: if true;
      allow read, get, list, update, delete: if isAdmin();
    }

    // 🏫 قوائم المدارس
    match /school-lists/{listId} {
      allow create: if true;
      allow read, get, list, update, delete: if isEditor();
    }

    // 🏭 التوريدات
    match /factory-supplies/{id} {
      allow create: if true;
      allow read, get, list, update, delete: if isEditor();
    }

    // 💰 المبيعات
    match /sales/{invoiceNumber} {
      allow create: if isEditor();
      allow read, get, list: if isAdmin();
      allow update, delete: if false;
    }

    // ⚙️ الإعدادات
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🔒 منع كل حاجة تانية
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
