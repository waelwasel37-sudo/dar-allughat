@tailwind base;
@tailwind components;
@tailwind utilities;

/* 🎯 1. نظام ألوان وتصميم موحد واحترافي لوحة الهوية الرئيسية لدار اللغات */
@layer base {
  :root {
    /* 🎨 لوحة الألوان الأساسية الموحدة لبراند دار اللغات */
    --color-primary: #0A2E54;       /* أزرق داكن (الهوية الرئيسية) */
    --color-primary-dark: #07223F;   /* نسخة أغمق للتأثيرات */
    --color-secondary: #FFC107;     /* ذهبي (للتأكيد ولفت الانتباه) */
    --color-secondary-light: #FFD54F; /* نسخة أفتح للتأثيرات */
    --color-accent: #F4EFEA;         /* بيج فاتح (للخلفيات الثانوية) */
    --color-background: #FFFFFF;     /* أبيض نقي (الخلفية الرئيسية) */
    --color-text-base: #212529;      /* رمادي داكن (للنصوص الأساسية) */
    --color-text-muted: #6c757d;    /* رمادي باهت (للنصوص الفرعية) */
    --color-white: #FFFFFF;
    --color-black: #000000;
    --color-success: #198754;
    --color-danger: #dc3545;
    --color-border: #dee2e6;

    /* ✒️ متغيرات الطباعة والخطوط العربية */
    --font-body: var(--font-noto-kufi-arabic), 'Cairo', sans-serif;
    --font-headings: 'Cairo', 'Helvetica Neue', sans-serif;

    /* ✨ متغيرات الظل والبرستيج البصري للعناصر */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    --shadow-glow-secondary: 0 0 20px 3px rgba(255, 193, 7, 0.5);

    /* 📐 متغيرات الأحجام وانحناءات الحدود للبطاقات */
    --border-radius-sm: 0.25rem;
    --border-radius-md: 0.5rem;
    --border-radius-lg: 1rem;
    --border-radius-full: 9999px;

    /* 🧩 متغيرات نظام الحاويات Shadcn/UI (موحدة ومتناسقة بالمليم) */
    --background: 0 0% 100%;             /* --color-background */
    --foreground: 215 14% 15%;           /* --color-text-base */
    --card: 0 0% 100%;
    --card-foreground: 215 14% 15%;
    --popover: 0 0% 100%;
    --popover-foreground: 215 14% 15%;
    --primary: 217 71% 18%;              /* --color-primary */
    --primary-foreground: 0 0% 100%;     /* --color-white */
    --secondary: 45 100% 51%;            /* --color-secondary */
    --secondary-foreground: 217 71% 18%; /* --color-primary */
    --muted: 210 20% 96%;
    --muted-foreground: 215 16% 47%;
    --accent: 30 29% 95%;                /* --color-accent */
    --accent-foreground: 215 14% 13%;
    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 100%;
    --border: 214 32% 91%;
    --input: 214 32% 91%;
    --ring: 217 71% 18%;
    --radius: 0.5rem;
  }

  /* قواعد شاشة المظهر الداكن */
  .dark {
    --background: 222 84% 5%;
    --foreground: 210 40% 98%;
  }

  * {
    @apply border-border;
  }
  body {
    /* تطبيق الخلفية البيضاء النقية والنص الأساسي الموحد */
    @apply bg-background text-foreground;
  }
}

/* 2. الأنماط العامة وإحكام الخطوط الافتراضية الاستجابية للـ SEO والـ UI */
body {
  background-color: var(--color-background);
  color: var(--color-text-base);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-headings);
  font-weight: 900; 
  color: var(--color-primary); /* استخدام الأزرق الداكن الصريح للعناوين */
  line-height: 1.3;
}

/* 📱 تحويل الخطوط لخطوط استجابية (Fluid Typography) حتى لا تنكسر العناوين على الجوال */
h1 { font-size: clamp(2rem, 5vw, 3rem); }      
h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); }    
h3 { font-size: clamp(1.4rem, 3vw, 1.75rem); }   
h4 { font-size: clamp(1.1rem, 2vw, 1.25rem); }
/* ========================================================================= */
/* ✒️ تنسيقات الفقرات والروابط العامة لتعزيز سهولة القراءة وتجربة المستخدم   */
/* ========================================================================= */
p {
  line-height: 1.8;
  font-weight: 500; 
  color: var(--color-text-muted); /* استخدام الرمادي الباهت للفقرات */
  margin-bottom: 1.25rem;
}

a {
  color: var(--color-primary); /* الأزرق الداكن كخيار افتراضي لسلامة القراءة والـ SEO */
  text-decoration: none;
  font-weight: 700; 
  transition: all 0.2s ease-in-out;
}
a:hover {
  color: var(--color-secondary); /* التحول للذهبي اللامع عند تمرير الماوس */
  text-decoration: underline;
}

/* ========================================================================= */
/* 🧩 مكونات مخصصة وأزرار النظام المتوافقة مع أسلوب Tailwind v3               */
/* ========================================================================= */
@layer components {
  .btn {
    @apply inline-block font-bold text-center uppercase tracking-wider
           px-8 py-4 rounded-md cursor-pointer 
           transition-all duration-300 ease-in-out;
    border: 2px solid transparent;
    font-family: var(--font-headings);
  }

  .btn-primary {
    @apply bg-secondary text-primary; /* زر ذهبي بنص أزرق داكن جذاب ومطابق للهوية */
    box-shadow: var(--shadow-md);
  }
  .btn-primary:hover {
    @apply bg-secondary-light;
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg), var(--shadow-glow-secondary);
  }

  .btn-secondary {
    @apply bg-transparent text-primary;
    border-color: var(--color-primary);
  }
  .btn-secondary:hover {
    @apply bg-primary text-white;
  }
  
  .card {
    @apply bg-white rounded-lg overflow-hidden;
    box-shadow: var(--shadow-md);
    transition: all 0.4s ease;
    border: 1px solid var(--color-border);
  }
  .card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }
}

/* ========================================================================= */
/* 🎯 أزرار "ارفع قائمة مدرستك" و "توريدات مصانع" - في SearchAndFilter      */
/* ========================================================================= */

/* ✅ زر ارفع قائمة مدرستك - أزرق داكن مع حركة عند المرور */
.btn-school-list {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background-color: var(--color-primary);
  color: var(--color-white);
  padding: 0.85rem 1.25rem;
  border-radius: var(--border-radius-md);
  font-weight: bold;
  font-size: 0.9rem;
  border: none;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn-school-list:hover {
  transform: translateY(-4px) scale(1.03);
  box-shadow: 
    0 12px 24px rgba(10, 46, 84, 0.30),
    0 4px 8px rgba(10, 46, 84, 0.15);
  background-color: var(--color-primary-dark);
  letter-spacing: 0.3px;
}

.btn-school-list:active {
  transform: translateY(-2px) scale(1.01);
}

/* ✨ تأثير لمعان يمر على الزر */
.btn-school-list::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.35),
    transparent
  );
  transition: left 0.6s ease;
  pointer-events: none;
}

.btn-school-list:hover::before {
  left: 100%;
}

/* ✅ زر توريدات مصانع ومؤسسات - أخضر زمردي فاخر مع حركة */
.btn-factory-supplies {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: var(--color-white);
  padding: 0.85rem 1.25rem;
  border-radius: var(--border-radius-md);
  font-weight: bold;
  font-size: 0.9rem;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn-factory-supplies:hover {
  transform: translateY(-4px) scale(1.03);
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  box-shadow: 
    0 12px 24px rgba(16, 185, 129, 0.40),
    0 4px 8px rgba(16, 185, 129, 0.20);
  letter-spacing: 0.3px;
}

.btn-factory-supplies:active {
  transform: translateY(-2px) scale(1.01);
}

/* ✨ تأثير لمعان للزر التوريدات */
.btn-factory-supplies::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.35),
    transparent
  );
  transition: left 0.6s ease;
  pointer-events: none;
}

.btn-factory-supplies:hover::before {
  left: 100%;
}