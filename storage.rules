rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. السماح للجميع بقراءة أي صورة في المتجر (شعار، منتجات، إلخ)
    match /{allPaths=**} {
      allow read;
    }

    // 2. مجلد صور المنتجات: الكتابة والحذف للأدمن وائل فقط
    match /products/{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.email == "waelwasel37@gmail.com";
    }

    // 3. مجلد قوائم المدارس: مسموح للجمهور بالرفع (create)، والحذف للأدمن فقط
    match /school-lists/{allPaths=**} {
      allow create: if true; // مسموح للجمهور برفع ملفاتهم وصورهم
      allow update, delete: if request.auth != null && request.auth.token.email == "waelwasel37@gmail.com";
    }

    // 4. مجلد طلبات التوريدات: مسموح للجمهور بالرفع، والحذف للأدمن فقط
    match /supplies/{allPaths=**} {
      allow create: if true; // مسموح للجمهور برفع طلبات المصانع والمؤسسات
      allow update, delete: if request.auth != null && request.auth.token.email == "waelwasel37@gmail.com";
    }
  }
}
