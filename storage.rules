rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. متوافق مع Firestore: السماح للجميع بقراءة أي صورة (منتجات، شعار)
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. متوافق مع Firestore (products): الرفع والتعديل والحذف للأدمن وائل فقط
    match /products/{allPaths=**} {
      allow create, update, delete: if request.auth != null && request.auth.token.email == "waelwasel37@gmail.com";
    }

    // 3. متوافق مع Firestore (school-lists): مسموح للجمهور بالرفع، والحذف للأدمن فقط
    match /school-lists/{allPaths=**} {
      allow create: if true; 
      allow update, delete: if request.auth != null && request.auth.token.email == "waelwasel37@gmail.com";
    }

    // 4. متوافق مع Firestore (توريدات): مسموح للجمهور بالرفع، والحذف للأدمن فقط
    match /supplies/{allPaths=**} {
      allow create: if true; 
      allow update, delete: if request.auth != null && request.auth.token.email == "waelwasel37@gmail.com";
    }
  }
}
